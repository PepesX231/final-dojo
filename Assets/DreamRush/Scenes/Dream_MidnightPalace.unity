  m_Name: 
  m_EditorClassIdentifier: DreamRush.Runtime::DreamRush.Palace.PalaceDirector
  districts:
  - name: NEON ALLEY
    thai: "\u0E0B\u0E2D\u0E22\u0E19\u0E35\u0E2D\u0E2D\u0E19\u0E40\u0E0B\u0E2D\u0E23\u0E4C\u0E40\u0E23\u0E35\u0E22\u0E25
      \u2014 \u0E16\u0E2D\u0E14\u0E23\u0E2B\u0E31\u0E2A\u0E2A\u0E31\u0E0D\u0E0D\u0E32\u0E13\u0E44\u0E1F\u0E41\u0E25\u0E30\u0E40\u0E2A\u0E49\u0E19\u0E17\u0E32\u0E07\u0E25\u0E31\u0E1A"
    center: {x: 0, y: 0, z: -112}
    radius: 80
    fog: {r: 0.050980393, g: 0.03137255, b: 0.14901961, a: 1}
    ambientSky: {r: 0.15686275, g: 0.09411765, b: 0.34509805, a: 1}
    ambientEquator: {r: 0.47843137, g: 0.09411765, b: 0.34509805, a: 1}
    halftone: {r: 0.95, g: 0.12, b: 0.45, a: 0.85}
  - name: CANDY ROOFTOPS
    thai: "\u0E14\u0E32\u0E14\u0E1F\u0E49\u0E32\u0E1B\u0E4A\u0E2D\u0E1B\u0E2D\u0E32\u0E23\u0E4C\u0E15
      \u2014 \u0E04\u0E33\u0E19\u0E27\u0E13\u0E27\u0E34\u0E16\u0E35\u0E44\u0E16\u0E25\u0E23\u0E32\u0E07\u0E41\u0E25\u0E30\u0E27\u0E07\u0E41\u0E2B\u0E27\u0E19\u0E04\u0E27\u0E32\u0E21\u0E40\u0E23\u0E47\u0E27"
    center: {x: 112, y: 0, z: 0}
    radius: 80
    fog: {r: 0.12156863, g: 0.03529412, b: 0.14117648, a: 1}
    ambientSky: {r: 0.30588236, g: 0.08627451, b: 0.27450982, a: 1}
    ambientEquator: {r: 0.6039216, g: 0.15686275, b: 0.28235295, a: 1}
    halftone: {r: 1, g: 0.78, b: 0.1, a: 0.85}
  - name: CLOCKWORK CANAL
    thai: "\u0E04\u0E25\u0E2D\u0E07\u0E1B\u0E23\u0E34\u0E0B\u0E36\u0E21 \u2014 \u0E27\u0E34\u0E40\u0E04\u0E23\u0E32\u0E30\u0E2B\u0E4C\u0E08\u0E31\u0E07\u0E2B\u0E27\u0E30\u0E1F\u0E31\u0E19\u0E40\u0E1F\u0E37\u0E2D\u0E07\u0E22\u0E49\u0E2D\u0E19\u0E40\u0E27\u0E25\u0E32"
    center: {x: 0, y: 0, z: 112}
    radius: 80
    fog: {r: 0.019607844, g: 0.09411765, b: 0.15686275, a: 1}
    ambientSky: {r: 0.0627451, g: 0.24313726, b: 0.3529412, a: 1}
    ambientEquator: {r: 0.09411765, g: 0.47843137, b: 0.47058824, a: 1}
    halftone: {r: 0, g: 0.92, b: 1, a: 0.85}
  - name: MOONLIT PLAZA
    thai: "\u0E25\u0E32\u0E19\u0E42\u0E21\u0E42\u0E19\u0E25\u0E34\u0E18 \u2014 \u0E41\u0E01\u0E49\u0E1B\u0E23\u0E34\u0E28\u0E19\u0E32\u0E41\u0E1C\u0E48\u0E19\u0E16\u0E48\u0E27\u0E07\u0E19\u0E49\u0E33\u0E2B\u0E19\u0E31\u0E01\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E1B\u0E25\u0E14\u0E1C\u0E19\u0E36\u0E01\u0E40\u0E07\u0E32!"
    center: {x: -112, y: 0, z: 0}
    radius: 80
    fog: {r: 0.03529412, g: 0.050980393, b: 0.16470589, a: 1}
    ambientSky: {r: 0.11764706, g: 0.15686275, b: 0.40784314, a: 1}
    ambientEquator: {r: 0.2901961, g: 0.18039216, b: 0.47058824, a: 1}
    halftone: {r: 0.45, g: 0.25, b: 1, a: 0.85}
  - name: THE CLOCK TOWER
    thai: "\u0E2B\u0E2D\u0E19\u0E32\u0E2C\u0E34\u0E01\u0E32 \u2014 \u0E17\u0E35\u0E48\u0E0B\u0E48\u0E2D\u0E19\u0E02\u0E2D\u0E07\u0E0A\u0E31\u0E48\u0E27\u0E42\u0E21\u0E07\u0E17\u0E35\u0E48\u0E2A\u0E34\u0E1A\u0E2A\u0E2D\u0E07"
