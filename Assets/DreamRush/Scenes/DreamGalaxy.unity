  title: MIDNIGHT PALACE
  subtitle: "OPEN WORLD  \xB7  \u0E1A\u0E2D\u0E2A: <color=#00E1FF>COUNT MIDNIGHT</color>"
  chapters: "\u25C6  \u0E40\u0E21\u0E37\u0E2D\u0E07\u0E01\u0E25\u0E32\u0E07\u0E04\u0E37\u0E19\u0E17\u0E35\u0E48\u0E40\u0E27\u0E25\u0E32\u0E2B\u0E22\u0E38\u0E14\u0E15\u0E2D\u0E19
