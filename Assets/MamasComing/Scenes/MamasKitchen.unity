  m_Script: {fileID: 11500000, guid: 93afcd27b039c194dbff298c7d68d693, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MamasComing.OvenHazard
  displayName: Toaster oven
  interactRadius: 1.3
  interactAnchor: {fileID: 2116242027}
  questEn: Turn off the toaster oven (pizza burning!)
  questTh: "\u0E1B\u0E34\u0E14\u0E40\u0E15\u0E32\u0E2D\u0E1A (\u0E1E\u0E34\u0E0B\u0E0B\u0E48\u0E32\u0E44\u0E2B\u0E21\u0E49!)"
  startEn: Something smells burnt... the PIZZA in the toaster oven! (kitchen)
  startTh: "\u0E44\u0E14\u0E49\u0E01\u0E25\u0E34\u0E48\u0E19\u0E44\u0E2B\u0E21\u0E49...
    \u0E1E\u0E34\u0E0B\u0E0B\u0E48\u0E32\u0E43\u0E19\u0E40\u0E15\u0E32\u0E2D\u0E1A!
    (\u0E04\u0E23\u0E31\u0E27)"
  failEn: The toaster oven CAUGHT FIRE!
  failTh: "\u0E40\u0E15\u0E32\u0E2D\u0E1A\u0E44\u0E1F\u0E25\u0E38\u0E01!"
  doneEn: Oven off. RIP pizza.
  doneTh: "\u0E1B\u0E34\u0E14\u0E40\u0E15\u0E32\u0E41\u0E25\u0E49\u0E27 \u0E25\u0E32\u0E01\u0E48\u0E2D\u0E19\u0E1E\u0E34\u0E0B\u0E0B\u0E48\u0E32"
  momEn: Why is the toaster oven still warm and smoky?!
  momTh: "\u0E17\u0E33\u0E44\u0E21\u0E40\u0E15\u0E32\u0E2D\u0E1A\u0E22\u0E31\u0E07\u0E23\u0E49\u0E2D\u0E19\u0E41\u0E25\u0E30\u0E21\u0E35\u0E04\u0E27\u0E31\u0E19?!"
  momFailEn: 
  momFailTh: 
  startAt: 90
  escalateTime: 70
  needsPower: 1
  coop: 0
  severity: 2
  startActive: 0
  puzzle: 1
  puzzleEn: TURN THE DIAL TO OFF!
  puzzleTh: "\u0E2B\u0E21\u0E38\u0E19\u0E1B\u0E38\u0E48\u0E21\u0E44\u0E1B\u0E17\u0E35\u0E48\u0E1B\u0E34\u0E14!"
  showWhenActive: []
  showWhenFixed: []
  showWhenFailed: []
  loopClip: hum
  loopVolume: 0.2
