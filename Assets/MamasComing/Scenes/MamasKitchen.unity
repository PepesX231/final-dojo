MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1658345431}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6d85f2e9c279be7429ae2ebd667c23cd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MamasComing.SparklerHazard
  displayName: Sparklers
  interactRadius: 1.6
  interactAnchor: {fileID: 88682498}
  questEn: Blow out the sparklers on the cake!
  questTh: "\u0E40\u0E1B\u0E48\u0E32\u0E14\u0E2D\u0E01\u0E44\u0E21\u0E49\u0E44\u0E1F\u0E1A\u0E19\u0E40\u0E04\u0E49\u0E01\u0E43\u0E2B\u0E49\u0E14\u0E31\u0E1A!"
  startEn: Someone lit the cake SPARKLERS... they're dripping onto the tablecloth!
    (dining)
  startTh: "\u0E43\u0E04\u0E23\u0E08\u0E38\u0E14\u0E14\u0E2D\u0E01\u0E44\u0E21\u0E49\u0E44\u0E1F\u0E1A\u0E19\u0E40\u0E04\u0E49\u0E01...
    \u0E2A\u0E30\u0E40\u0E01\u0E47\u0E14\u0E44\u0E1F\u0E2B\u0E22\u0E14\u0E25\u0E07\u0E1C\u0E49\u0E32\u0E1B\u0E39\u0E42\u0E15\u0E4A\u0E30!
    (\u0E2B\u0E49\u0E2D\u0E07\u0E01\u0E34\u0E19\u0E02\u0E49\u0E32\u0E27)"
  failEn: The TABLECLOTH caught fire!
  failTh: "\u0E1C\u0E49\u0E32\u0E1B\u0E39\u0E42\u0E15\u0E4A\u0E30\u0E15\u0E34\u0E14\u0E44\u0E1F!"
  doneEn: Phew... sparklers out.
  doneTh: "\u0E40\u0E2E\u0E49\u0E2D... \u0E14\u0E31\u0E1A\u0E41\u0E25\u0E49\u0E27"
  momEn: Why is there a half-burnt cake on my dining table?
  momTh: "\u0E17\u0E33\u0E44\u0E21\u0E21\u0E35\u0E40\u0E04\u0E49\u0E01\u0E44\u0E2B\u0E21\u0E49\u0E04\u0E23\u0E36\u0E48\u0E07
    \u0E46 \u0E1A\u0E19\u0E42\u0E15\u0E4A\u0E30\u0E01\u0E34\u0E19\u0E02\u0E49\u0E32\u0E27?"
  momFailEn: 
  momFailTh: 
  startAt: 160
  escalateTime: 40
  needsPower: 0
  coop: 0
  severity: 1
  startActive: 0
  puzzle: 8
  puzzleEn: BLOW!! BLOW!!
  puzzleTh: "\u0E40\u0E1B\u0E48\u0E32!! \u0E40\u0E1B\u0E48\u0E32!!"
  showWhenActive: []
  showWhenFixed: []
  showWhenFailed: []
  loopClip: sparkle
  loopVolume: 0.3
  sparks: {fileID: 1254681354}
  clothFire: {fileID: 787976148}
