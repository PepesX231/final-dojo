  m_Script: {fileID: 11500000, guid: a942c44e6fe86b048994656ec8ac1c6f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MamasComing.GadgetHazard
  displayName: Escaped slime
  interactRadius: 1.7
  interactAnchor: {fileID: 13488587}
  questEn: Scoop up Gloop the slime (bucket!)
  questTh: "\u0E15\u0E31\u0E01\u0E2A\u0E44\u0E25\u0E21\u0E4C\u0E01\u0E25\u0E31\u0E1A
    (\u0E43\u0E0A\u0E49\u0E16\u0E31\u0E07!)"
  startEn: Gloop the glow slime ESCAPED its jar! (bedroom)
  startTh: "\u0E2A\u0E44\u0E25\u0E21\u0E4C\u0E40\u0E23\u0E37\u0E2D\u0E07\u0E41\u0E2A\u0E07\u0E2B\u0E19\u0E35\u0E2D\u0E2D\u0E01\u0E08\u0E32\u0E01\u0E02\u0E27\u0E14!
    (\u0E2B\u0E49\u0E2D\u0E07\u0E19\u0E2D\u0E19)"
  failEn: Gloop slimed the whole upstairs!
  failTh: "\u0E2A\u0E44\u0E25\u0E21\u0E4C\u0E40\u0E25\u0E2D\u0E30\u0E17\u0E31\u0E49\u0E07\u0E0A\u0E31\u0E49\u0E19\u0E1A\u0E19!"
  doneEn: Gloop is home. Good slime.
  doneTh: "\u0E2A\u0E44\u0E25\u0E21\u0E4C\u0E01\u0E25\u0E31\u0E1A\u0E1A\u0E49\u0E32\u0E19\u0E41\u0E25\u0E49\u0E27"
  momEn: Why is there GREEN GOO on the stairs?!
  momTh: "\u0E17\u0E33\u0E44\u0E21\u0E21\u0E35\u0E40\u0E21\u0E37\u0E2D\u0E01\u0E40\u0E02\u0E35\u0E22\u0E27\u0E1A\u0E19\u0E1A\u0E31\u0E19\u0E44\u0E14?!"
  momFailEn: 
  momFailTh: 
  startAt: 230
