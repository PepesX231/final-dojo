  m_Script: {fileID: 11500000, guid: a942c44e6fe86b048994656ec8ac1c6f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MamasComing.GadgetHazard
  displayName: Parrot
  interactRadius: 1.5
  interactAnchor: {fileID: 1474285667}
  questEn: Cover Mango's cage (towel!) before Mom hears
  questTh: "\u0E40\u0E2D\u0E32\u0E1C\u0E49\u0E32\u0E04\u0E25\u0E38\u0E21\u0E01\u0E23\u0E07\u0E19\u0E01\u0E41\u0E01\u0E49\u0E27
    (\u0E1C\u0E49\u0E32\u0E02\u0E19\u0E2B\u0E19\u0E39!) \u0E01\u0E48\u0E2D\u0E19\u0E41\u0E21\u0E48\u0E44\u0E14\u0E49\u0E22\u0E34\u0E19"
  startEn: 
  startTh: 
  failEn: Mango is screaming PARTY! PARTY! - Mom will hear it the second she walks
    in!
  failTh: "\u0E19\u0E01\u0E41\u0E01\u0E49\u0E27\u0E15\u0E30\u0E42\u0E01\u0E19 \u0E1B\u0E32\u0E23\u0E4C\u0E15\u0E35\u0E49!
    \u0E1B\u0E32\u0E23\u0E4C\u0E15\u0E35\u0E49! - \u0E41\u0E21\u0E48\u0E44\u0E14\u0E49\u0E22\u0E34\u0E19\u0E41\u0E19\u0E48!"
  doneEn: Shhh... night night, Mango.
  doneTh: "\u0E0A\u0E39\u0E48\u0E27... \u0E1D\u0E31\u0E19\u0E14\u0E35\u0E19\u0E30"
  momEn: '"PAAARTY! SQUAWK! PARTY PARTY!"... Mango, WHO TAUGHT YOU THAT?!'
  momTh: "\"\u0E1B\u0E32\u0E23\u0E4C\u0E15\u0E35\u0E49! \u0E41\u0E04\u0E27\u0E49\u0E01!
    \u0E1B\u0E32\u0E23\u0E4C\u0E15\u0E35\u0E49!\"... \u0E43\u0E04\u0E23\u0E2A\u0E2D\u0E19\u0E19\u0E01\u0E1E\u0E39\u0E14\u0E41\u0E1A\u0E1A\u0E19\u0E35\u0E49?!"
  momFailEn: 
  momFailTh: 
