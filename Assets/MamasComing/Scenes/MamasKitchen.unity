  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a942c44e6fe86b048994656ec8ac1c6f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MamasComing.GadgetHazard
  displayName: Grandfather clock
  interactRadius: 1.5
  interactAnchor: {fileID: 1146443286}
  questEn: Reset the clock before it chimes 13
  questTh: "\u0E15\u0E31\u0E49\u0E07\u0E19\u0E32\u0E2C\u0E34\u0E01\u0E32\u0E01\u0E48\u0E2D\u0E19\u0E15\u0E35\u0E04\u0E23\u0E1A
    13 \u0E17\u0E35"
  startEn: BONG... BONG... the grandfather clock is chiming way too many times! (hallway)
  startTh: "\u0E40\u0E2B\u0E07\u0E48\u0E07... \u0E40\u0E2B\u0E07\u0E48\u0E07... \u0E19\u0E32\u0E2C\u0E34\u0E01\u0E32\u0E15\u0E35\u0E40\u0E01\u0E34\u0E19\u0E08\u0E33\u0E19\u0E27\u0E19!
    (\u0E17\u0E32\u0E07\u0E40\u0E14\u0E34\u0E19)"
  failEn: BONG #13! Mom thinks she's LATE and is rushing home!
  failTh: "\u0E40\u0E2B\u0E07\u0E48\u0E07\u0E17\u0E35\u0E48 13! \u0E41\u0E21\u0E48\u0E19\u0E36\u0E01\u0E27\u0E48\u0E32\u0E2A\u0E32\u0E22
    \u0E23\u0E35\u0E1A\u0E01\u0E25\u0E31\u0E1A\u0E1A\u0E49\u0E32\u0E19!"
  doneEn: Tick tock, all good.
  doneTh: "\u0E15\u0E34\u0E4A\u0E01\u0E15\u0E48\u0E2D\u0E01 \u0E40\u0E23\u0E35\u0E22\u0E1A\u0E23\u0E49\u0E2D\u0E22"
  momEn: Why is the clock wrong?
  momTh: "\u0E17\u0E33\u0E44\u0E21\u0E19\u0E32\u0E2C\u0E34\u0E01\u0E32\u0E40\u0E14\u0E34\u0E19\u0E1C\u0E34\u0E14?"
  momFailEn: 
  momFailTh: 
  startAt: 300
  escalateTime: 90
  needsPower: 0
  coop: 0
