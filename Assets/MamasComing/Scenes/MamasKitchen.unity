  m_Script: {fileID: 11500000, guid: 6ed16dfbf02a8b64099b054d943e1ab6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MamasComing.CeilingFanHazard
  displayName: Ceiling fan switch
  interactRadius: 1.2
  interactAnchor: {fileID: 1362855837}
  questEn: Switch off the ceiling fan (cake is flying!)
  questTh: "\u0E1B\u0E34\u0E14\u0E1E\u0E31\u0E14\u0E25\u0E21\u0E40\u0E1E\u0E14\u0E32\u0E19
    (\u0E40\u0E04\u0E49\u0E01\u0E1B\u0E25\u0E34\u0E27\u0E27\u0E48\u0E2D\u0E19!)"
  startEn: 
  startTh: 
  failEn: SPLAT! The whole cake flew off - right onto the TV!
  failTh: "\u0E41\u0E1B\u0E30! \u0E40\u0E04\u0E49\u0E01\u0E17\u0E31\u0E49\u0E07\u0E01\u0E49\u0E2D\u0E19\u0E1B\u0E25\u0E34\u0E27\u0E44\u0E1B\u0E15\u0E34\u0E14\u0E08\u0E2D\u0E17\u0E35\u0E27\u0E35!"
  doneEn: Fan off. Now wipe up the frosting.
  doneTh: "\u0E1B\u0E34\u0E14\u0E1E\u0E31\u0E14\u0E25\u0E21\u0E41\u0E25\u0E49\u0E27
    \u0E40\u0E0A\u0E47\u0E14\u0E04\u0E23\u0E35\u0E21\u0E14\u0E49\u0E27\u0E22"
  momEn: Is that CAKE on my ceiling fan?!
  momTh: "\u0E19\u0E31\u0E48\u0E19\u0E40\u0E04\u0E49\u0E01\u0E15\u0E34\u0E14\u0E1E\u0E31\u0E14\u0E25\u0E21\u0E40\u0E1E\u0E14\u0E32\u0E19\u0E40\u0E2B\u0E23\u0E2D?!"
  momFailEn: WHY IS THERE CAKE ON THE TV?!
  momFailTh: "\u0E17\u0E33\u0E44\u0E21\u0E21\u0E35\u0E40\u0E04\u0E49\u0E01\u0E15\u0E34\u0E14\u0E08\u0E2D\u0E17\u0E35\u0E27\u0E35?!"
  startAt: -1
  escalateTime: 80
  needsPower: 1
  coop: 0
  severity: 1
  startActive: 1
  puzzle: 0
  puzzleEn: 
  puzzleTh: 
  showWhenActive: []
  showWhenFixed: []
  showWhenFailed: []
  loopClip: whir
  loopVolume: 0.2
