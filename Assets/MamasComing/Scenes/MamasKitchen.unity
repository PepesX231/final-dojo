  m_Script: {fileID: 11500000, guid: a942c44e6fe86b048994656ec8ac1c6f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MamasComing.GadgetHazard
  displayName: Dryer
  interactRadius: 1.5
  interactAnchor: {fileID: 1887424513}
  questEn: Stop the dryer melting crayons
  questTh: "\u0E2B\u0E22\u0E38\u0E14\u0E40\u0E04\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E2D\u0E1A\u0E1C\u0E49\u0E32\u0E17\u0E35\u0E48\u0E2B\u0E25\u0E2D\u0E21\u0E2A\u0E35\u0E40\u0E17\u0E35\u0E22\u0E19"
  startEn: The dryer is melting CRAYONS - rainbow smoke! (laundry)
  startTh: "\u0E40\u0E04\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E2D\u0E1A\u0E1C\u0E49\u0E32\u0E2B\u0E25\u0E2D\u0E21\u0E2A\u0E35\u0E40\u0E17\u0E35\u0E22\u0E19
    \u0E04\u0E27\u0E31\u0E19\u0E2A\u0E35\u0E23\u0E38\u0E49\u0E07! (\u0E2B\u0E49\u0E2D\u0E07\u0E0B\u0E31\u0E01\u0E1C\u0E49\u0E32)"
  failEn: Rainbow wax all over the laundry room!
  failTh: "\u0E02\u0E35\u0E49\u0E1C\u0E36\u0E49\u0E07\u0E2A\u0E35\u0E23\u0E38\u0E49\u0E07\u0E40\u0E25\u0E2D\u0E30\u0E17\u0E31\u0E49\u0E07\u0E2B\u0E49\u0E2D\u0E07!"
  doneEn: Dryer off. The towels are... colourful.
  doneTh: "\u0E1B\u0E34\u0E14\u0E41\u0E25\u0E49\u0E27 \u0E1C\u0E49\u0E32\u0E02\u0E19\u0E2B\u0E19\u0E39\u0E01\u0E25\u0E32\u0E22\u0E40\u0E1B\u0E47\u0E19\u0E2B\u0E25\u0E32\u0E01\u0E2A\u0E35"
  momEn: Why are all my towels RAINBOW?!
  momTh: "\u0E17\u0E33\u0E44\u0E21\u0E1C\u0E49\u0E32\u0E02\u0E19\u0E2B\u0E19\u0E39\u0E41\u0E21\u0E48\u0E01\u0E25\u0E32\u0E22\u0E40\u0E1B\u0E47\u0E19\u0E2A\u0E35\u0E23\u0E38\u0E49\u0E07?!"
  momFailEn: 
  momFailTh: 
