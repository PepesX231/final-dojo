  m_Script: {fileID: 11500000, guid: 55ec42bf0fb4bf44dbfceadcdb1951bd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MamasComing.FridgeHazard
  displayName: Fridge
  interactRadius: 1.3
  interactAnchor: {fileID: 393636443}
  questEn: Close the fridge (food is warming up!)
  questTh: "\u0E1B\u0E34\u0E14\u0E15\u0E39\u0E49\u0E40\u0E22\u0E47\u0E19 (\u0E2D\u0E32\u0E2B\u0E32\u0E23\u0E01\u0E33\u0E25\u0E31\u0E07\u0E08\u0E30\u0E40\u0E2A\u0E35\u0E22!)"
  startEn: 
  startTh: 
  failEn: The fridge food SPOILED... it stinks!
  failTh: "\u0E2D\u0E32\u0E2B\u0E32\u0E23\u0E43\u0E19\u0E15\u0E39\u0E49\u0E40\u0E22\u0E47\u0E19\u0E1A\u0E39\u0E14\u0E41\u0E25\u0E49\u0E27...
    \u0E40\u0E2B\u0E21\u0E47\u0E19\u0E21\u0E32\u0E01!"
  doneEn: Fridge closed. Still cold!
  doneTh: "\u0E1B\u0E34\u0E14\u0E15\u0E39\u0E49\u0E40\u0E22\u0E47\u0E19\u0E41\u0E25\u0E49\u0E27
    \u0E22\u0E31\u0E07\u0E40\u0E22\u0E47\u0E19\u0E2D\u0E22\u0E39\u0E48!"
  momEn: Who left the FRIDGE OPEN?!
  momTh: "\u0E43\u0E04\u0E23\u0E40\u0E1B\u0E34\u0E14\u0E15\u0E39\u0E49\u0E40\u0E22\u0E47\u0E19\u0E17\u0E34\u0E49\u0E07\u0E44\u0E27\u0E49?!"
  momFailEn: UGH what is that SMELL?! Everything in the fridge is rotten!
  momFailTh: "\u0E2D\u0E35\u0E4B \u0E01\u0E25\u0E34\u0E48\u0E19\u0E2D\u0E30\u0E44\u0E23?!
    \u0E02\u0E2D\u0E07\u0E43\u0E19\u0E15\u0E39\u0E49\u0E40\u0E22\u0E47\u0E19\u0E40\u0E19\u0E48\u0E32\u0E2B\u0E21\u0E14\u0E40\u0E25\u0E22!"
  startAt: -1
  escalateTime: 160
  needsPower: 0
  coop: 0
  severity: 2
  startActive: 1
  puzzle: 0
  puzzleEn: 
  puzzleTh: 
