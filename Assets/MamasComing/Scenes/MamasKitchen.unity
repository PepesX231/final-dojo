  puzzleTh: "\u0E02\u0E31\u0E19\u0E23\u0E39\u0E19\u0E49\u0E33\u0E41\u0E02\u0E47\u0E07\u0E43\u0E2B\u0E49\u0E41\u0E19\u0E48\u0E19"
