  m_Script: {fileID: 11500000, guid: af58a4e2d7019c84fa675525fafa21f5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MamasComing.AquariumHazard
  displayName: Fish tank
  interactRadius: 1.4
  interactAnchor: {fileID: 1866458397}
  questEn: Patch the cracked fish tank!
  questTh: "\u0E2D\u0E38\u0E14\u0E23\u0E2D\u0E22\u0E23\u0E49\u0E32\u0E27\u0E15\u0E39\u0E49\u0E1B\u0E25\u0E32!"
  startEn: 
  startTh: 
  failEn: The fish tank is pouring out! The game room is flooding!
  failTh: "\u0E19\u0E49\u0E33\u0E43\u0E19\u0E15\u0E39\u0E49\u0E1B\u0E25\u0E32\u0E44\u0E2B\u0E25\u0E17\u0E30\u0E25\u0E31\u0E01\u0E41\u0E25\u0E49\u0E27!
    \u0E2B\u0E49\u0E2D\u0E07\u0E40\u0E25\u0E48\u0E19\u0E40\u0E01\u0E21\u0E19\u0E49\u0E33\u0E17\u0E48\u0E27\u0E21!"
  doneEn: Tank patched! Put the fish back in!
  doneTh: "\u0E2D\u0E38\u0E14\u0E15\u0E39\u0E49\u0E1B\u0E25\u0E32\u0E41\u0E25\u0E49\u0E27!
    \u0E40\u0E2D\u0E32\u0E1B\u0E25\u0E32\u0E43\u0E2A\u0E48\u0E04\u0E37\u0E19\u0E44\u0E14\u0E49!"
  momEn: Why is the fish tank cracked and taped?!
  momTh: "\u0E17\u0E33\u0E44\u0E21\u0E15\u0E39\u0E49\u0E1B\u0E25\u0E32\u0E23\u0E49\u0E32\u0E27\u0E41\u0E25\u0E49\u0E27\u0E41\u0E1B\u0E30\u0E40\u0E17\u0E1B\u0E44\u0E27\u0E49?!"
  momFailEn: 
  momFailTh: 
  startAt: 280
  escalateTime: 90
  needsPower: 0
  coop: 0
  severity: 2
  startActive: 0
  puzzle: 10
  puzzleEn: TAPE THE CRACK!
  puzzleTh: "\u0E41\u0E1B\u0E30\u0E40\u0E17\u0E1B\u0E1B\u0E34\u0E14\u0E23\u0E2D\u0E22\u0E23\u0E49\u0E32\u0E27!"
