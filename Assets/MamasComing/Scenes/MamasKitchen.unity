  m_Script: {fileID: 11500000, guid: a942c44e6fe86b048994656ec8ac1c6f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MamasComing.GadgetHazard
  displayName: Garbage disposal
  interactRadius: 1.5
  interactAnchor: {fileID: 1278494796}
  questEn: Pull the spoon out of the garbage disposal
  questTh: "\u0E14\u0E36\u0E07\u0E0A\u0E49\u0E2D\u0E19\u0E2D\u0E2D\u0E01\u0E08\u0E32\u0E01\u0E40\u0E04\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E1A\u0E14\u0E40\u0E28\u0E29\u0E2D\u0E32\u0E2B\u0E32\u0E23"
  startEn: GRRRRZZT! A spoon is stuck in the garbage disposal! (kitchen)
  startTh: "\u0E41\u0E01\u0E23\u0E4A\u0E01! \u0E0A\u0E49\u0E2D\u0E19\u0E15\u0E34\u0E14\u0E43\u0E19\u0E40\u0E04\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E1A\u0E14\u0E40\u0E28\u0E29\u0E2D\u0E32\u0E2B\u0E32\u0E23!
    (\u0E04\u0E23\u0E31\u0E27)"
  failEn: The disposal overheated and blew the fuse!
  failTh: "\u0E40\u0E04\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E1A\u0E14\u0E23\u0E49\u0E2D\u0E19\u0E08\u0E31\u0E14\u0E08\u0E19\u0E1F\u0E34\u0E27\u0E2A\u0E4C\u0E02\u0E32\u0E14!"
  doneEn: Spoon rescued. Bent, but rescued.
  doneTh: "\u0E44\u0E14\u0E49\u0E0A\u0E49\u0E2D\u0E19\u0E04\u0E37\u0E19\u0E41\u0E25\u0E49\u0E27
    \u0E07\u0E2D\u0E19\u0E34\u0E14\u0E2B\u0E19\u0E48\u0E2D\u0E22"
  momEn: Why is my good spoon bent in half?
  momTh: "\u0E17\u0E33\u0E44\u0E21\u0E0A\u0E49\u0E2D\u0E19\u0E14\u0E35\u0E02\u0E2D\u0E07\u0E41\u0E21\u0E48\u0E07\u0E2D\u0E40\u0E1B\u0E47\u0E19\u0E04\u0E23\u0E36\u0E48\u0E07?"
  momFailEn: 
  momFailTh: 
