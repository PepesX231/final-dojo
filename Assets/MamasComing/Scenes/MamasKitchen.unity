  puzzleTh: "\u0E1B\u0E34\u0E14\u0E21\u0E34\u0E01\u0E40\u0E0B\u0E2D\u0E23\u0E4C (\u0E01\u0E14\u0E15\u0E32\u0E21\u0E44\u0E1F)"
