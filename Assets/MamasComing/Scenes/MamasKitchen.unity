  displayName: DJ mixer
  interactRadius: 1.4
  interactAnchor: {fileID: 1180656020}
  questEn: Turn the party music DOWN (neighbours!)
  questTh: "\u0E25\u0E14\u0E40\u0E2A\u0E35\u0E22\u0E07\u0E40\u0E1E\u0E25\u0E07\u0E1B\u0E32\u0E23\u0E4C\u0E15\u0E35\u0E49
    (\u0E02\u0E49\u0E32\u0E07\u0E1A\u0E49\u0E32\u0E19\u0E23\u0E33\u0E04\u0E32\u0E0D!)"
  startEn: 
  startTh: 
  failEn: The speakers OVERLOADED the circuit!
  failTh: "\u0E25\u0E33\u0E42\u0E1E\u0E07\u0E14\u0E36\u0E07\u0E44\u0E1F\u0E40\u0E01\u0E34\u0E19!"
  doneEn: Silence... sweet silence.
  doneTh: "\u0E40\u0E07\u0E35\u0E22\u0E1A\u0E41\u0E25\u0E49\u0E27... \u0E2A\u0E1A\u0E32\u0E22\u0E2B\u0E39"
  momEn: Why are there DJ speakers in my house?!
  momTh: "\u0E17\u0E33\u0E44\u0E21\u0E21\u0E35\u0E25\u0E33\u0E42\u0E1E\u0E07\u0E14\u0E35\u0E40\u0E08\u0E43\u0E19\u0E1A\u0E49\u0E32\u0E19?!"
  momFailEn: 
  momFailTh: 
  startAt: -1
  escalateTime: 120
  needsPower: 1
  coop: 0
  severity: 2
  startActive: 1
  puzzle: 4
  puzzleEn: SHUT DOWN THE MIXER (repeat the lights)
  puzzleTh: "\u0E1B\u0E34\u0E14\u0E21\u0E34\u0E01\u0E40\u0E0B\u0E2D\u0E23\u0E4C (\u0E01\u0E14\u0E15\u0E32\u0E21\u0E44\u0E1F)"
