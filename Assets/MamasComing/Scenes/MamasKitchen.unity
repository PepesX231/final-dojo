  m_Script: {fileID: 11500000, guid: a942c44e6fe86b048994656ec8ac1c6f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MamasComing.GadgetHazard
  displayName: Blender
  interactRadius: 1.5
  interactAnchor: {fileID: 231896639}
  questEn: Put a LID on the blender (and switch it off)
  questTh: "\u0E40\u0E2D\u0E32\u0E1D\u0E32\u0E1B\u0E34\u0E14\u0E40\u0E04\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E1B\u0E31\u0E48\u0E19
    (\u0E41\u0E25\u0E49\u0E27\u0E1B\u0E34\u0E14\u0E2A\u0E27\u0E34\u0E15\u0E0A\u0E4C)"
  startEn: The blender is spraying SMOOTHIE everywhere! (kitchen)
  startTh: "\u0E40\u0E04\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E1B\u0E31\u0E48\u0E19\u0E1E\u0E48\u0E19\u0E2A\u0E21\u0E39\u0E17\u0E15\u0E35\u0E49\u0E40\u0E15\u0E47\u0E21\u0E04\u0E23\u0E31\u0E27!
    (\u0E04\u0E23\u0E31\u0E27)"
  failEn: Smoothie on the CEILING!
  failTh: "\u0E2A\u0E21\u0E39\u0E17\u0E15\u0E35\u0E49\u0E15\u0E34\u0E14\u0E40\u0E1E\u0E14\u0E32\u0E19!"
  doneEn: Lid on. Sticky, but quiet.
  doneTh: "\u0E1B\u0E34\u0E14\u0E1D\u0E32\u0E41\u0E25\u0E49\u0E27 \u0E40\u0E2B\u0E19\u0E35\u0E22\u0E27\u0E41\u0E15\u0E48\u0E40\u0E07\u0E35\u0E22\u0E1A"
  momEn: Why is everything pink and sticky?!
  momTh: "\u0E17\u0E33\u0E44\u0E21\u0E17\u0E38\u0E01\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E2A\u0E35\u0E0A\u0E21\u0E1E\u0E39\u0E41\u0E25\u0E49\u0E27\u0E40\u0E2B\u0E19\u0E35\u0E22\u0E27?!"
  momFailEn: 
  momFailTh: 
  startAt: 120
  escalateTime: 70
  needsPower: 1
