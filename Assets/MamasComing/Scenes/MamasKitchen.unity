  m_Script: {fileID: 11500000, guid: a942c44e6fe86b048994656ec8ac1c6f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MamasComing.GadgetHazard
  displayName: Hoverboard
  interactRadius: 1.5
  interactAnchor: {fileID: 530441338}
  questEn: Unplug the smoking hoverboard
  questTh: "\u0E16\u0E2D\u0E14\u0E1B\u0E25\u0E31\u0E4A\u0E01\u0E42\u0E2E\u0E40\u0E27\u0E2D\u0E23\u0E4C\u0E1A\u0E2D\u0E23\u0E4C\u0E14\u0E17\u0E35\u0E48\u0E21\u0E35\u0E04\u0E27\u0E31\u0E19"
  startEn: The hoverboard charger is SMOKING! (landing)
  startTh: "\u0E17\u0E35\u0E48\u0E0A\u0E32\u0E23\u0E4C\u0E08\u0E42\u0E2E\u0E40\u0E27\u0E2D\u0E23\u0E4C\u0E1A\u0E2D\u0E23\u0E4C\u0E14\u0E21\u0E35\u0E04\u0E27\u0E31\u0E19!
    (\u0E0A\u0E32\u0E19\u0E1E\u0E31\u0E01\u0E1A\u0E31\u0E19\u0E44\u0E14)"
  failEn: The hoverboard CAUGHT FIRE!
  failTh: "\u0E42\u0E2E\u0E40\u0E27\u0E2D\u0E23\u0E4C\u0E1A\u0E2D\u0E23\u0E4C\u0E14\u0E44\u0E1F\u0E25\u0E38\u0E01!"
  doneEn: Unplugged. Hoverboard lives.
  doneTh: "\u0E16\u0E2D\u0E14\u0E41\u0E25\u0E49\u0E27 \u0E23\u0E2D\u0E14\u0E15\u0E32\u0E22"
  momEn: Why does the landing smell like burnt plastic?
  momTh: "\u0E17\u0E33\u0E44\u0E21\u0E0A\u0E32\u0E19\u0E1E\u0E31\u0E01\u0E1A\u0E31\u0E19\u0E44\u0E14\u0E21\u0E35\u0E01\u0E25\u0E34\u0E48\u0E19\u0E1E\u0E25\u0E32\u0E2A\u0E15\u0E34\u0E01\u0E44\u0E2B\u0E21\u0E49?"
  momFailEn: 
  momFailTh: 
  startAt: 190
  escalateTime: 80
  needsPower: 1
  coop: 0
