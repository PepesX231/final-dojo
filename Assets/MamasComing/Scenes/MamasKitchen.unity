  m_Script: {fileID: 11500000, guid: a942c44e6fe86b048994656ec8ac1c6f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MamasComing.GadgetHazard
  displayName: Garage door
  interactRadius: 1.5
  interactAnchor: {fileID: 348530844}
  questEn: Stop the haunted garage door (BOTH buttons together)
  questTh: "\u0E2B\u0E22\u0E38\u0E14\u0E1B\u0E23\u0E30\u0E15\u0E39\u0E42\u0E23\u0E07\u0E23\u0E16\u0E1C\u0E35\u0E2A\u0E34\u0E07
    (\u0E01\u0E14 2 \u0E1B\u0E38\u0E48\u0E21\u0E1E\u0E23\u0E49\u0E2D\u0E21\u0E01\u0E31\u0E19)"
  startEn: The garage door is going UP-DOWN-UP-DOWN by itself! (garage)
  startTh: "\u0E1B\u0E23\u0E30\u0E15\u0E39\u0E42\u0E23\u0E07\u0E23\u0E16\u0E02\u0E36\u0E49\u0E19\u0E25\u0E07\u0E40\u0E2D\u0E07\u0E44\u0E21\u0E48\u0E2B\u0E22\u0E38\u0E14!
    (\u0E42\u0E23\u0E07\u0E23\u0E16)"
  failEn: CLANG CLANG CLANG - the whole street can hear it!
  failTh: "\u0E42\u0E04\u0E23\u0E21 \u0E46 \u0E46 - \u0E44\u0E14\u0E49\u0E22\u0E34\u0E19\u0E17\u0E31\u0E49\u0E07\u0E0B\u0E2D\u0E22!"
  doneEn: Door stopped. Spooky.
  doneTh: "\u0E1B\u0E23\u0E30\u0E15\u0E39\u0E2B\u0E22\u0E38\u0E14\u0E41\u0E25\u0E49\u0E27
    \u0E19\u0E48\u0E32\u0E02\u0E19\u0E25\u0E38\u0E01"
  momEn: Why is the garage door motor so HOT?
  momTh: "\u0E17\u0E33\u0E44\u0E21\u0E21\u0E2D\u0E40\u0E15\u0E2D\u0E23\u0E4C\u0E1B\u0E23\u0E30\u0E15\u0E39\u0E42\u0E23\u0E07\u0E23\u0E16\u0E23\u0E49\u0E2D\u0E19\u0E08\u0E31\u0E07?"
