  m_Script: {fileID: 11500000, guid: a942c44e6fe86b048994656ec8ac1c6f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MamasComing.GadgetHazard
  displayName: Smart speaker
  interactRadius: 1.5
  interactAnchor: {fileID: 1048724528}
  questEn: Delete the party recording on the smart speaker
  questTh: "\u0E25\u0E1A\u0E40\u0E2A\u0E35\u0E22\u0E07\u0E1B\u0E32\u0E23\u0E4C\u0E15\u0E35\u0E49\u0E43\u0E19\u0E25\u0E33\u0E42\u0E1E\u0E07\u0E2D\u0E31\u0E08\u0E09\u0E23\u0E34\u0E22\u0E30"
  startEn: '"Recording... Sending ''PARTY.mp3'' to MOM in 3 minutes!" (upstairs hall)'
  startTh: "\"\u0E01\u0E33\u0E25\u0E31\u0E07\u0E2D\u0E31\u0E14... \u0E08\u0E30\u0E2A\u0E48\u0E07
    'PARTY.mp3' \u0E43\u0E2B\u0E49\u0E41\u0E21\u0E48\u0E43\u0E19 3 \u0E19\u0E32\u0E17\u0E35!\"
    (\u0E17\u0E32\u0E07\u0E40\u0E14\u0E34\u0E19\u0E0A\u0E31\u0E49\u0E19\u0E1A\u0E19)"
  failEn: '"Message sent to Mom." She''s coming home EARLY!'
  failTh: "\"\u0E2A\u0E48\u0E07\u0E02\u0E49\u0E2D\u0E04\u0E27\u0E32\u0E21\u0E2B\u0E32\u0E41\u0E21\u0E48\u0E41\u0E25\u0E49\u0E27\"
    \u0E41\u0E21\u0E48\u0E01\u0E25\u0E31\u0E1A\u0E40\u0E23\u0E47\u0E27\u0E02\u0E36\u0E49\u0E19!"
  doneEn: Recording deleted. No witnesses.
  doneTh: "\u0E25\u0E1A\u0E41\u0E25\u0E49\u0E27 \u0E44\u0E21\u0E48\u0E21\u0E35\u0E1E\u0E22\u0E32\u0E19"
  momEn: Hey assistant, play the last recording... hmm, it's empty?
  momTh: "\u0E1C\u0E39\u0E49\u0E0A\u0E48\u0E27\u0E22 \u0E40\u0E1B\u0E34\u0E14\u0E40\u0E2A\u0E35\u0E22\u0E07\u0E25\u0E48\u0E32\u0E2A\u0E38\u0E14...
    \u0E2D\u0E49\u0E32\u0E27 \u0E27\u0E48\u0E32\u0E07?"
  momFailEn: 
  momFailTh: 
  startAt: 260
  escalateTime: 180
  needsPower: 1
