  m_Script: {fileID: 11500000, guid: a942c44e6fe86b048994656ec8ac1c6f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MamasComing.GadgetHazard
  displayName: Popcorn machine
  interactRadius: 1.5
  interactAnchor: {fileID: 399413748}
  questEn: Shut the popcorn machine before it burns
  questTh: "\u0E1B\u0E34\u0E14\u0E40\u0E04\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E17\u0E33\u0E1B\u0E4A\u0E2D\u0E1B\u0E04\u0E2D\u0E23\u0E4C\u0E19\u0E01\u0E48\u0E2D\u0E19\u0E44\u0E2B\u0E21\u0E49"
  startEn: POP POP POP - the popcorn machine is going crazy! (game room)
  startTh: "\u0E1B\u0E4A\u0E2D\u0E01 \u0E1B\u0E4A\u0E2D\u0E01 \u0E1B\u0E4A\u0E2D\u0E01
    - \u0E40\u0E04\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E1B\u0E4A\u0E2D\u0E1B\u0E04\u0E2D\u0E23\u0E4C\u0E19\u0E04\u0E25\u0E31\u0E48\u0E07!
    (\u0E2B\u0E49\u0E2D\u0E07\u0E40\u0E25\u0E48\u0E19\u0E40\u0E01\u0E21)"
  failEn: The popcorn is BURNING!
  failTh: "\u0E1B\u0E4A\u0E2D\u0E1B\u0E04\u0E2D\u0E23\u0E4C\u0E19\u0E44\u0E2B\u0E21\u0E49!"
  doneEn: Popcorn secured. Snack time later.
  doneTh: "\u0E40\u0E23\u0E35\u0E22\u0E1A\u0E23\u0E49\u0E2D\u0E22 \u0E44\u0E27\u0E49\u0E01\u0E34\u0E19\u0E17\u0E35\u0E2B\u0E25\u0E31\u0E07"
  momEn: Why are there popcorn kernels in my carpet?
  momTh: "\u0E17\u0E33\u0E44\u0E21\u0E21\u0E35\u0E1B\u0E4A\u0E2D\u0E1B\u0E04\u0E2D\u0E23\u0E4C\u0E19\u0E43\u0E19\u0E1E\u0E23\u0E21?"
